'LehmerFollowup.counterexample_lt_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
'LehmerFollowup.mem_fixedCount_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
'LehmerFollowup.conjecture_iff_all_fixedCount_empty' depends on axioms: [propext, Classical.choice, Quot.sound]
'LehmerFollowup.standard_conjecture_iff_all_fixedCount_empty' depends on axioms: [propext, Classical.choice, Quot.sound]
'LehmerFollowup.first_three_counts_empty' depends on axioms: [propext, Classical.choice, Quot.sound]
'LehmerFollowup.last_entry_equation' depends on axioms: [propext, Classical.choice, Quot.sound]
'LehmerFollowup.last_entry_unique' depends on axioms: [propext, Classical.choice, Quot.sound]
'LehmerFollowup.unit_deficit_forces_prefix_product' depends on axioms: [propext, Classical.choice, Quot.sound]
'LehmerFollowup.unit_deficit_excludes_prime_tail' depends on axioms: [propext, Classical.choice, Quot.sound]
'LehmerFollowup.two_entry_identity' depends on axioms: [propext, Quot.sound]
def LehmerFollowup.Counterexample : ℕ → Prop :=
fun n => 1 < n ∧ ¬Nat.Prime n ∧ φ n ∣ n - 1
def LehmerFollowup.bound : ℕ → ℕ :=
fun k => 2 ^ 2 ^ k
def LehmerFollowup.fixedCount : ℕ → Finset ℕ :=
fun k => {n ∈ range (bound k) | Counterexample n ∧ #n.primeFactors = k}
