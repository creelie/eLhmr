theorem eightCompletions_length : eightCompletions.length = 21 := by decide +kernel

theorem eightCompletions_check : eightCompletions.all Completion.check = true := by decide +kernel

/-- Each of the 21 completions satisfies `A' p q + 1 = 2 B' (p - 1)(q - 1)` with `s < p < q`, and `p` and `q`
are not both prime. -/
theorem eight_completions {e : Completion} (he : e ∈ eightCompletions) :
    e.A * e.p * e.q + 1 = 2 * e.B * (e.p - 1) * (e.q - 1) ∧ e.s < e.p ∧ e.p < e.q ∧
      ¬ (e.p.Prime ∧ e.q.Prime) := by
  have h := List.all_eq_true.mp eightCompletions_check e he
  simp only [Completion.check, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨heq, hsp⟩, hpq⟩, hd⟩, hdiv⟩ := h
  refine ⟨heq, hsp, hpq, ?_⟩
  rintro ⟨hp, hq⟩
  rcases hdiv with ⟨hdp, hmod⟩ | ⟨hdq, hmod⟩
  · exact Nat.not_prime_of_dvd_of_lt (Nat.dvd_of_mod_eq_zero hmod) hd hdp hp
  · exact Nat.not_prime_of_dvd_of_lt (Nat.dvd_of_mod_eq_zero hmod) hd hdq hq

end LehmerTotient
