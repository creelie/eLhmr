import LehmerTotient.Imports

/-!
# The completions of the eight-prime search (Section 7.4)

The search finds 21 completions `s < p < q` in integers, that is, prefixes `p₁, …, p₅` and integers `s < p < q`
with `A' p q + 1 = 2 B' (p - 1)(q - 1)`, where `A' = p₁ ⋯ p₅ s` and `B' = (p₁ - 1) ⋯ (p₅ - 1)(s - 1)`. Each is
listed with a divisor `d` of `p` or of `q`, `1 < d`, smaller than that entry, so that `p` and `q` are not both
prime. The kernel checks all of this (`decide +kernel`). Generated by `scripts/gen_eight.py`.
-/

namespace LehmerTotient

/-- A completion: the prefix, `s = p₆`, the last two entries `p < q`, and a divisor `d` of `p` or `q`. -/
structure Completion where
  pre : List ℕ
  s : ℕ
  p : ℕ
  q : ℕ
  d : ℕ

/-- `A' = p₁ ⋯ p₅ s`. -/
def Completion.A (e : Completion) : ℕ := e.pre.prod * e.s

/-- `B' = (p₁ - 1) ⋯ (p₅ - 1)(s - 1)`. -/
def Completion.B (e : Completion) : ℕ := (e.pre.map (· - 1)).prod * (e.s - 1)

/-- The check: the equation, `s < p < q`, and `d` a proper divisor of `p` or of `q`. -/
def Completion.check (e : Completion) : Bool :=
  (e.A * e.p * e.q + 1 == 2 * e.B * (e.p - 1) * (e.q - 1)) && decide (e.s < e.p) && decide (e.p < e.q) &&
    decide (1 < e.d) && ((decide (e.d < e.p) && e.p % e.d == 0) || (decide (e.d < e.q) && e.q % e.d == 0))

/-- The 21 completions found by the search, in increasing order. -/
def eightCompletions : List Completion := [
