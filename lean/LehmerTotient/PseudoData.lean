import LehmerTotient.PseudoExtend

/-!
# A pseudo-solution prime to 3 with 25 entries (Section 9.6)

`pseudoXs` has 25 entries. The kernel checks (`decide +kernel`) that it is a companion pseudo-solution prime to 3 and
that `3 ∣ ∏ (xᵢ - 1)`. With `companion_all` and `lehmer_all` this gives pseudo-solutions prime to 3 of
`x₁ ⋯ x_k + 1 = 2 ∏ (xᵢ - 1)` for every `k ≥ 25` and of `x₁ ⋯ x_k - 1 = 2 ∏ (xᵢ - 1)` for every `k ≥ 26`.
-/

namespace LehmerTotient

/-- The 25 entries; the first nine are the prefix `(5, 7, 13, 17, 19, 23, 25, 37, 119)` of Section 9.6. -/
def pseudoXs : List ℕ := [
  5,
  7,
  13,
  17,
  19,
  23,
  25,
  37,
  119,
  147563,
  45571237,
  46357278045502805,
  137525948407415701591844144386513,
  196645733712598430524974674340614201514527075219722621302159736435,
  3571994111646236313862351571984103048663191419822308065354285255202998144945960749160057426531928455002203928410994945345147633,
  17731386882304281043605611600665923241728854613977914450047916521378356330673204052934391426757921603327063362274807964777874206669348346150233279029429208051357624148504152171973656337836372723815310309344606492198870061356482950660663773091515364709385,
  ,
  ,
