theorem pseudoXs_length : pseudoXs.length = 25 := by decide +kernel

theorem pseudoXs_companion : CompanionPS pseudoXs := by
  unfold CompanionPS EntriesOK pm1
  decide +kernel

theorem pseudoXs_three : 3 ∣ pm1 pseudoXs := by
  unfold pm1
  decide +kernel

/-- Companion pseudo-solutions prime to 3 exist for every `k ≥ 25`. -/
theorem companion_pseudo_prime_to_three (k : ℕ) (hk : 25 ≤ k) : ∃ l, l.length = k ∧ CompanionPS l := by
  obtain ⟨l, hl, hc, -, -⟩ :=
    companion_all pseudoXs_companion pseudoXs_three (by decide +kernel) (k - 25)
  exact ⟨l, by rw [hl, pseudoXs_length]; omega, hc⟩

/-- Lehmer pseudo-solutions prime to 3 exist for every `k ≥ 26`. -/
theorem lehmer_pseudo_prime_to_three (k : ℕ) (hk : 26 ≤ k) : ∃ l, l.length = k ∧ LehmerPS l := by
  obtain ⟨l, hl, hc⟩ := lehmer_all pseudoXs_companion pseudoXs_three (by decide +kernel) (k - 26)
  exact ⟨l, by rw [hl, pseudoXs_length]; omega, hc⟩

end LehmerTotient
